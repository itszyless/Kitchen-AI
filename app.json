{
  "expo": {
    "name": "Kitchen AI",
    "slug": "kitchen-ai",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/full/lightmode.png",
    "scheme": [
      "kitchen-ai",
      "cook"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/icons/full/lightmode.png",
        "dark": "./assets/images/icons/full/darkmode.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icons/full/lightmode.png",
        "backgroundColor": "#171719"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icons/full/lightmode.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icons/lightmode_text.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kitchen AI to scan ingredients, your fridge and food barcodes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kitchen AI to identify food in photos you choose.",
          "cameraPermission": "Allow Kitchen AI to scan ingredients, your fridge and food barcodes.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
